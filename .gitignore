# Local environments and caches
.venv*/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
.env.*
!.env.example
# Downloaded assets; committed manifests and experiment logs remain visible
vendor/
models/
*.safetensors
*.pt
*.pth
*.bin
*.npy
*.npz
*.parquet
*.arrow
**/training_state.pt
**/*.incomplete/
**/*.previous*/
# Local/generated downloads and new experiments
artifacts/
outputs/
*.tmp
.DS_Store
# Only provenance manifests are distributed from data/
data/**
!data/**/
!data/**/manifest.json
!data/README.md
# Fresh local training assets
**/latest_checkpoint/
**/best_checkpoint/
**/final_checkpoint/
**/resume_checkpoint/
**/recovery_checkpoint/
**/stopped_checkpoint/
**/checkpoints/
**/rollouts.jsonl
**/*_rollouts.jsonl
**/rollouts_*.jsonl

.local_materialized.json
# Sanitized metadata is intentionally committed, including periodic descriptors.
!runs/**/checkpoint_metadata/
!runs/**/checkpoint_metadata/**/
!runs/**/checkpoint_metadata/**/*.json
